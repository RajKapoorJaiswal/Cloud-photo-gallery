PORT=3001
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/cloud-photo-gallery
JWT_SECRET=your-jwt-access-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
JWT_EXPIRES_IN=15m
CLIENT_URL=http://localhost:3000

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth Credentials (Optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Cloudinary Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_registered_sender@gmail.com
SMTP_PASS=your_16_character_google_app_password
EMAIL_FROM=Cloud Photo Gallery <your_registered_sender@gmail.com>
SMTP_FROM=Cloud Photo Gallery <your_registered_sender@gmail.com>
